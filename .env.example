# context.dev API key — https://context.dev (free tier is enough for the demo)
# Used as: Authorization: Bearer $CONTEXT_DEV_API_KEY
CONTEXT_DEV_API_KEY=

# Port. Render injects this automatically; locally it defaults to 3000.
PORT=3000

# Optional: shared secret required in the x-tool-secret header on /tools/* and /admin/*.
# Leave empty to disable auth (fine for the hackathon demo; set it in production).
TOOL_SHARED_SECRET=

# Optional: outbound fetch timeout in ms. Must stay well under the ElevenLabs 20s tool timeout.
FETCH_TIMEOUT_MS=12000

# Optional: timeout for the keyless adsb.lol aircraft-position lookup. This is enrichment on
# top of an answer we can already give, so it is deliberately shorter than FETCH_TIMEOUT_MS.
ADSB_TIMEOUT_MS=6000

# Optional: background advisory cache re-warm interval in ms. Set to 0 to disable.
CACHE_REFRESH_MS=300000

# Only needed by scripts/provision-elevenlabs.js, never by the server itself.
# ELEVENLABS_API_KEY=
